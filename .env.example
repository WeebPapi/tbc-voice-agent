# Local POC only — never commit real secrets.
BIND_HOST=127.0.0.1
VOICE_API_PORT=8000
MOCK_TBC_PORT=8090
WEB_PORT=5173

MOCK_TBC_BASE_URL=http://127.0.0.1:8090
MOCK_TBC_BEARER_TOKEN=dev-mock-tbc-token

# Optional — required for English browser voice at /. If set, STT/LLM/TTS auto-switch from fake → openai.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Optional — Georgian voice at /ka only. Requires BOTH key and voice ID. Never auto-switches English providers.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
ELEVENLABS_STT_LANGUAGE_CODE=kat
ELEVENLABS_TTS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID=
ELEVENLABS_INPUT_SAMPLE_RATE=16000
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_CONNECT_TIMEOUT_SECONDS=10
ELEVENLABS_TURN_TIMEOUT_SECONDS=15
# Enterprise only; omit/false unless your account supports zero-retention.
ELEVENLABS_ZERO_RETENTION=false

# Defaults stay fake for offline text demos. With OPENAI_API_KEY set, fake→openai automatically.
TRANSPORT_PROVIDER=text
STT_PROVIDER=fake
LLM_PROVIDER=fake
TTS_PROVIDER=fake
VOICE_LANGUAGE=en-US
POLICY_VERSION=poc-v1
CONTENT_VERSION=en-poc-v1
# Optional ISO date used as "today" for PTP bounds. Empty means the real current date.
POLICY_AS_OF_DATE=

# SQLite paths (created on start)
VOICE_DB_PATH=data/voice_agent.sqlite
MOCK_DB_PATH=data/mock_tbc.sqlite

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
